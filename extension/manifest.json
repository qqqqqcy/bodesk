{
  "manifest_version": 3,
  "name": "BOSS 沟通助手 · 本地版",
  "version": "0.3.2",
  "description": "在本地整理 BOSS 对话、公司与 JD，在浮窗修改状态并记录公司、职位备注。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.zhipin.com/*", "http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开采集与导出"},
  "content_scripts": [
    {"matches": ["https://www.zhipin.com/web/*", "https://www.zhipin.com/job_detail/*", "http://127.0.0.1:4173/web/*", "http://127.0.0.1:4173/job_detail/*", "http://localhost:4173/web/*", "http://localhost:4173/job_detail/*"], "js": ["main.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://www.zhipin.com/web/*", "https://www.zhipin.com/job_detail/*", "http://127.0.0.1:4173/web/*", "http://127.0.0.1:4173/job_detail/*", "http://localhost:4173/web/*", "http://localhost:4173/job_detail/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
